{
  "name": "vindex",
  // worker.ts envuelve el Worker de OpenNext y le suma la tarea programada.
  "main": "worker.ts",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Respaldo de consultas cuyo correo al estudio falló (src/lib/intake/pendientes.ts).
  "kv_namespaces": [
    {
      "binding": "CONSULTAS_PENDIENTES",
      "id": "cc418479f0db4440aa52804cf13cacaf"
    }
  ],
  // Reintento de esas consultas cada 10 minutos (UTC).
  "unsafe": {
    "bindings": [
      {
        "name": "INTAKE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "SMTP_USER": "info@vindexlegal.com.ar",
    "MAIL_FROM": "VINDEX LEGAL <info@vindexlegal.com.ar>",
    "MAIL_TO": "info@vindexlegal.com.ar"
  }
}