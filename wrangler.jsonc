{
  "name": "vindex",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "SMTP_USER": "info@vindexlegal.com.ar",
    "MAIL_FROM": "VINDEX LEGAL <info@vindexlegal.com.ar>",
    "MAIL_TO": "info@vindexlegal.com.ar"
  },
  // Memoria por contacto del agente de WhatsApp (perfil + historial de
  // conversación). Crear con `wrangler kv namespace create WHATSAPP_KV` y
  // reemplazar el id de abajo por el que devuelva ese comando — ver README.
  "kv_namespaces": [
    {
      "binding": "WHATSAPP_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}