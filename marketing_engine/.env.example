# Copiá este archivo a .env (marketing_engine/.env) y completá. .env NO se versiona.

# --- Obligatoria -------------------------------------------------------------
# Clave de Google AI Studio (https://aistudio.google.com/apikey). Habilita Gemini
# y Google Search Grounding para el Radar y el Auditor.
GEMINI_API_KEY=

# --- Modelos (opcionales; cambian sin tocar código) ---------------------------
# Google retira modelos seguido. Para ver cuáles puede usar TU clave:
#   python -m marketing_engine.main --list-models
MODEL_STRATEGY=gemini-3.1-pro-preview
MODEL_WRITER=gemini-3.1-pro-preview
MODEL_AUDITOR=gemini-3.1-pro-preview
# Tarea liviana (estructurar JSON). Podés poner un modelo flash más barato si figura en la lista.
MODEL_FAST=gemini-3.1-pro-preview

# --- Plan de 90 días ------------------------------------------------------------
# Fecha del día 1 del plan (AAAA-MM-DD).
PLAN_START_DATE=2026-11-23
# Cadencia semanal de lunes a domingo; vacío = sin publicación ese día.
# Por defecto: lun blog, mar tip, mié tip, jue blog, vie tip, sáb y dom descanso.
PLAN_CADENCE=blog,tip,tip,blog,tip,,

# --- Calidad ----------------------------------------------------------------------
# Revisiones que se le permiten al redactor antes de escalar al CMO.
MAX_REVISIONES=3
# Veces que el CMO puede reformular un tema antes de abortar.
MAX_ESCALACIONES=1

# --- Git y publicación --------------------------------------------------------------
# Rama donde el publicador commitea (se crea si no existe). Vacío = rama actual.
# Recomendado: una rama de revisión, nunca main directo.
GIT_BRANCH=marketing/auto
# true = además hace push de la rama (también con --push).
GIT_PUSH=false
GIT_REMOTE=origin
# true = corre `npm run build` completo tras build-content (lento; requiere npm ci).
FULL_BUILD=false
